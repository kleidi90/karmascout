# Copy this file to `.env` and fill in real values.
# `.env` is gitignored and must never be committed.

# ── Required ────────────────────────────────────────────────────────────────

# OpenRouter API key, used to score threads and draft comments.
# Get one at https://openrouter.ai — starts with "sk-or-v1-".
KARMASCOUT_OPENROUTER_API_KEY=sk-or-v1-replace-me

# ── Optional: contact details for the Reddit user agent ─────────────────────
# Reddit asks that automated clients identify a contact. Defaults to
# "unknown" if unset, which still works but is not good citizenship.
KARMASCOUT_REDDIT_CONTACT=your-reddit-username

# ── Optional: model ─────────────────────────────────────────────────────────
# "openrouter/auto" lets OpenRouter pick a cheap/free model.
KARMASCOUT_OPENROUTER_MODEL=openrouter/auto

# ── Optional: search tuning ─────────────────────────────────────────────────
# Only consider threads newer than this many hours.
KARMASCOUT_MAX_AGE_HOURS=24
# Only report threads the AI scores at or above this (1-10).
KARMASCOUT_MIN_SCORE=7

# ── Optional: account context injected into the AI prompt ───────────────────
KARMASCOUT_ACCOUNT_KARMA=818
KARMASCOUT_ACCOUNT_AGE_DAYS=30

# ── Optional: request pacing and concurrency ────────────────────────────────
# Seconds to sleep between Reddit requests. Reddit throttles search.rss hard.
KARMASCOUT_FETCH_DELAY=0.8
# Parallel OpenRouter scoring calls. OpenRouter is not IP-throttled like Reddit.
KARMASCOUT_AI_CONCURRENCY=4
# Seconds between progress heartbeat lines.
KARMASCOUT_HEARTBEAT_INTERVAL=60

# ── Optional: cost control ──────────────────────────────────────────────────
# Every collected thread costs one paid OpenRouter call. This caps how many a
# single run may send, newest first. 0 disables the cap.
KARMASCOUT_MAX_ITEMS_TO_SCORE=150

# Reuse the verdict already computed for a thread in an earlier run. The report is
# unchanged - same scores, same drafts - only the repeated spend goes away. Set to
# false, or pass --no-cache, to re-score everything from scratch.
KARMASCOUT_CACHE_ENABLED=true
KARMASCOUT_CACHE_PATH=.karmascout_cache.json

# ── Optional: logging ───────────────────────────────────────────────────────
# One of DEBUG, INFO, WARNING, ERROR, CRITICAL.
KARMASCOUT_LOG_LEVEL=INFO

# ── Optional: JSON-encoded overrides for the keyword and subreddit lists ────
# Leave unset to use the defaults baked into src/karmascout/config.py.
# KARMASCOUT_KEYWORDS=["Lärmprotokoll","Ruhestörung"]
# KARMASCOUT_SUBREDDITS=["germany","de"]
