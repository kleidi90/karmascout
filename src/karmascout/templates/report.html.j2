<!DOCTYPE html>
<html lang="de">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>KarmaScout Results</title>
<style>
  * { box-sizing: border-box; margin: 0; padding: 0; }
  body { font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; background: #f0f2f5; color: #111; min-height: 100vh; }
  .topbar { background: #1a1a2e; color: white; padding: 18px 24px; display: flex; align-items: center; gap: 12px; }
  .topbar h1 { font-size: 18px; font-weight: 700; }
  .topbar .sub { font-size: 13px; color: #aaa; margin-left: auto; }
  .container { max-width: 820px; margin: 0 auto; padding: 24px 16px; }
  .summary { background: white; border-radius: 10px; padding: 14px 18px; margin-bottom: 20px; font-size: 13px; color: #555; box-shadow: 0 1px 3px rgba(0,0,0,.08); display: flex; gap: 20px; flex-wrap: wrap; }
  .summary strong { color: #111; }
  .card { background: white; border-radius: 12px; padding: 20px; margin-bottom: 16px; box-shadow: 0 1px 4px rgba(0,0,0,.09); }
  .card-header { display: flex; align-items: center; gap: 10px; margin-bottom: 10px; }
  .score-badge { font-size: 13px; font-weight: 700; padding: 3px 11px; border-radius: 20px; }
  .meta { font-size: 12px; color: #888; }
  .title { font-size: 15px; font-weight: 600; line-height: 1.45; margin-bottom: 8px; }
  .body-text { font-size: 13px; color: #555; line-height: 1.55; margin-bottom: 10px; }
  .reason { font-size: 13px; color: #444; background: #f7f8fa; border-left: 3px solid #d1d5db; padding: 8px 12px; border-radius: 0 6px 6px 0; margin-bottom: 10px; }
  .risk { font-size: 13px; color: #92400e; background: #fef3c7; padding: 7px 12px; border-radius: 6px; margin-bottom: 10px; }
  .draft-warning { font-size: 13px; line-height: 1.5; color: #7f1d1d; background: #fee2e2; border: 1px solid #fca5a5; padding: 9px 12px; border-radius: 6px; margin-bottom: 12px; }
  .draft-warning code { font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 12px; background: rgba(0,0,0,.06); padding: 1px 5px; border-radius: 4px; word-break: break-all; }
  .link-row { display: flex; align-items: flex-start; gap: 6px; margin-bottom: 16px; font-size: 13px; }
  .link-icon { flex-shrink: 0; margin-top: 1px; }
  .thread-link { color: #2563eb; text-decoration: none; word-break: break-all; line-height: 1.4; }
  .thread-link:hover { text-decoration: underline; }
  .comments { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
  @media (max-width: 580px) { .comments { grid-template-columns: 1fr; } }
  .comment-box { background: #f8f9fb; border: 1px solid #e5e7eb; border-radius: 8px; padding: 14px; display: flex; flex-direction: column; }
  .comment-label { font-size: 11px; font-weight: 600; text-transform: uppercase; letter-spacing: .6px; color: #888; margin-bottom: 8px; }
  .comment-text { font-size: 14px; line-height: 1.6; color: #1a1a1a; flex: 1; margin-bottom: 12px; }
  .copy-btn { align-self: flex-start; background: #2563eb; color: white; border: none; padding: 6px 16px; border-radius: 6px; font-size: 12px; font-weight: 600; cursor: pointer; transition: background .15s, transform .1s; }
  .copy-btn:hover { background: #1d4ed8; }
  .copy-btn:active { transform: scale(.97); }
  .copy-btn.copied { background: #16a34a; }
</style>
</head>
<body>
<div class="topbar">
  <h1>🎯 KarmaScout</h1>
  <span class="sub">{{ run_time }} &nbsp;·&nbsp; {{ cards | length }} opportunities</span>
</div>
<div class="container">
  <div class="summary">
    <span><strong>Subreddits:</strong> {{ subreddit_labels | join(', ') }}</span>
    <span><strong>Keywords:</strong> {{ keywords | join(', ') }}</span>
    <span><strong>Min score:</strong> {{ min_score }}/10</span>
    <span><strong>Account:</strong> {{ account_karma }} karma · {{ account_age_days }} days old</span>
  </div>
  {% for card in cards %}
        <div class="card">
            <div class="card-header">
                <span class="score-badge" style="color:{{ card.badge_color }};background:{{ card.badge_bg }}">{{ card.score }}/10</span>
                <span class="meta">{{ card.age_hours }}h ago &nbsp;·&nbsp; r/{{ card.subreddit }} &nbsp;·&nbsp; keyword: {{ card.keyword }}</span>
            </div>
            <h2 class="title">{{ card.title }}</h2>
            {%- if card.body %}
            <p class="body-text">{{ card.body }}</p>
            {%- endif %}
            <div class="reason">💡 {{ card.score_reason }}</div>
            {%- if card.risk %}
            <div class="risk">⚠️ {{ card.risk }}</div>
            {%- endif %}
            <div class="link-row">
                <span class="link-icon">🔗</span>
                {%- if card.safe_url %}
                <a href="{{ card.safe_url }}" class="thread-link" target="_blank" rel="noopener">{{ card.url }}</a>
                {%- else %}
                <span class="thread-link">{{ card.url }}</span>
                {%- endif %}
            </div>
            {%- if card.draft_links %}
            <div class="draft-warning">
              🚩 <strong>Check before posting.</strong> These drafts contain
              {{ card.draft_links | length }} link{{ '' if card.draft_links | length == 1 else 's' }},
              which the prompt never asks for — a sign the thread may have steered the model:
              {% for link in card.draft_links %}<code>{{ link }}</code>{% if not loop.last %}, {% endif %}{% endfor %}
            </div>
            {%- endif %}
            <div class="comments">
                <div class="comment-box">
                    <div class="comment-label">Comment A — main</div>
                    <div class="comment-text" id="ca{{ loop.index0 }}">{{ card.comment_a }}</div>
                    <button class="copy-btn" onclick="copyById('ca{{ loop.index0 }}', this)">Copy</button>
                </div>
                <div class="comment-box">
                    <div class="comment-label">Comment B — alternative</div>
                    <div class="comment-text" id="cb{{ loop.index0 }}">{{ card.comment_b }}</div>
                    <button class="copy-btn" onclick="copyById('cb{{ loop.index0 }}', this)">Copy</button>
                </div>
            </div>
        </div>
  {%- endfor %}
</div>
<script>
  function copyById(id, btn) {
    const text = document.getElementById(id).innerText;
    navigator.clipboard.writeText(text).then(() => {
      btn.textContent = 'Copied!';
      btn.classList.add('copied');
      setTimeout(() => { btn.textContent = 'Copy'; btn.classList.remove('copied'); }, 2000);
    });
  }
</script>
</body>
</html>
